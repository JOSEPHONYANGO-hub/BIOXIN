# Copy to .env for local development. In Coolify, set these under Environment Variables.

# Public site address, without a trailing slash (e.g. https://bioxcin.co.ke).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# "production" lets search engines index the site; anything else (e.g. "staging") adds noindex.
NEXT_PUBLIC_SITE_ENV=staging

# Enquiry email. MESSAGING_MODE=dry-run logs enquiries instead of sending them.
MESSAGING_MODE=dry-run
ENQUIRY_TO=info@eloriabeauty.co.ke
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
